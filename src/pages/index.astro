---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Mine from '../components/Mine';
import Search from '../components/Search';
import { lineRef, network, startRow } from '../lib/network';

const tiles = [
  { href: '/linije', icon: 'bus', title: 'Linije' },
  { href: '/stanice', icon: 'pin', title: 'Stanice' },
  { href: '/put', icon: 'route', title: 'Put' },
  { href: '/karta', icon: 'map', title: 'Karta' },
] as const;
const mine = network.lines.map((l) => ({
  line: lineRef(l),
  long: l.long,
  dirs: l.dirs.map((d) => ({ id: d.id, to: d.label, t: startRow(d).t })),
}));
---

<Layout section="pocetna">
  <div class="wrap hero" slot="hero">
    <h1>Kad ide bus?</h1>
    <Search client:load />
  </div>
  <div class="home">
    <ul class="tiles">
      {tiles.map((t) => <li><a href={t.href}><Icon name={t.icon} size={32} />{t.title}</a></li>)}
    </ul>
    <Mine lines={mine} client:load />
  </div>
</Layout>
