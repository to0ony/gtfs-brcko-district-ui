---
// Vozni red linije s prijedlogom za vikende i praznike, za ispis i spremanje u PDF: /analiza/pdf?linija=8
import '@fontsource-variable/overpass';
import LinePdf from '../../analiza/LinePdf';
import '../../styles/pdf.css';
import jezik from '../../scripts/jezik.js?raw';
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Prijedlog za vikende i praznike</title>
    <meta name="robots" content="noindex" />
    <script is:inline set:html={jezik}></script>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  </head>
  <body>
    <LinePdf client:only="preact"><p slot="fallback" class="bar">Učitavam…</p></LinePdf>
    <noscript><p class="bar">Ova stranica radi samo s uključenim JavaScriptom.</p></noscript>
  </body>
</html>
